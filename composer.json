{
  "name": "gan-007/mpesa",
  "description": "Production-ready PHP SDK for Safaricom M-PESA Daraja APIs.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "symfony/dotenv": "^6.4 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Safaricom\\Mpesa\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Safaricom\\Mpesa\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
